# ==========================================
# APPLICATION
# ==========================================
APP_NAME=TravelPilot
APP_ENV=development
DEBUG=true

# ==========================================
# LLM
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL_SMALL=gemini-3.5-flash-lite
GEMINI_MODEL_MEDIUM=gemini-3.7-flash
GEMINI_MODEL_LARGE=gemini-3.8-flash

# ==========================================
# OPENSTREETMAP / NOMINATIM
# ==========================================
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TravelPilot/1.0 (your-email@example.com)

# ==========================================
# OVERPASS
# ==========================================
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# ==========================================
# OSRM
# ==========================================
OSRM_BASE_URL=https://router.project-osrm.org

# =========================
# Open-Meteo
# =========================

# Current / future weather forecasts
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_TIMEOUT=10

# Historical forecast data (2021+)
OPEN_METEO_HISTORICAL_FORECAST_URL=https://historical-forecast-api.open-meteo.com/v1
OPEN_METEO_HISTORICAL_FORECAST_TIMEOUT=15

# ==========================================
# WIKIPEDIA / MEDIAWIKI
# ==========================================
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php

# ==========================================
# DATABASE
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travelpilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ==========================================
# REDIS
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# RAG / VECTOR STORE
# ==========================================
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ==========================================
# APPLICATION URLS
# ==========================================
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8501